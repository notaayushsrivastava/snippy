{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snippy",
  "version": "0.1.0",
  "identifier": "app.snippy.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @snippy/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm --filter @snippy/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snippy",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
