{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snippy",
  "version": "0.1.0",
  "identifier": "app.snippy.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @snippy/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm --filter @snippy/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snippy",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Snippy Overlay",
        "url": "index.html#overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "width": 320,
        "height": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
